# CJ프레시웨이 세무 판례 AI 비서 - 환경변수 설정 템플릿
# 본 파일을 복사하여 .env 파일을 생성한 뒤 실제 사내 API 키 및 접속 정보를 입력해 주십시오.

# 1. 법제처/국가법령정보센터 Open API 사용자 ID (OC)
# 발급처: https://open.law.go.kr
LAW_API_KEY=your_law_open_api_oc_here

# 2-A. 사내 ChatGPT Enterprise - Azure OpenAI 방식 (대기업 사내망 보안 권장)
# 사내 클라우드/AI 포털 또는 AX 공모전 운영진에게 발급받은 정보 입력
AZURE_OPENAI_ENDPOINT=https://your-company.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_32char_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# 2-B. 사내 ChatGPT Enterprise - 일반 OpenAI API 방식 (Azure 엔드포인트가 없을 때 사용)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# 3. 보안 로그인 계정 설정 (Gatekeeper Auth)
AUTH_ENABLED=true
ADMIN_ID=admin
ADMIN_PASSWORD=cj_tax_admin_2026!
USER_ID=user
USER_PASSWORD=cj_freshway_2026!

# 4. 데이터 저장 디렉터리 (기본값: 프로젝트 루트 디렉터리)
# DATA_DIR=./data

# 5. 세법 적용 기준일 (기본값: 2026-01-01)
TAX_BASE_DATE=2026-01-01

# 6. 외부 공개 터널 모드 플래그
IS_TUNNEL_MODE=false
