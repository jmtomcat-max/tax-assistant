# ==============================================================================
# CJ프레시웨이 세무 판례 AI 비서 - Streamlit Cloud Secrets 설정 템플릿
# ==============================================================================
# [설정 방법]
# Streamlit Community Cloud 대시보드 (share.streamlit.io)에서 앱 선택 후
# Settings > Secrets 메뉴에 아래 내용을 복사하여 실제 키와 비밀번호를 입력합니다.
# ==============================================================================

# 1. 국가법령정보센터 공식 DRF API 사용자 인증키 (OC)
LAW_API_KEY = "your_law_api_key_here"

# 2. ChatGPT Enterprise 또는 Azure OpenAI / OpenAI API 키
OPENAI_API_KEY = "your_openai_api_key_here"
OPENAI_MODEL = "gpt-4o"

# (선택) Azure OpenAI 사용 시 아래 항목 추가
# AZURE_OPENAI_ENDPOINT = "https://your-resource.openai.azure.com/"
# AZURE_OPENAI_API_KEY = "your_azure_key_here"
# AZURE_OPENAI_DEPLOYMENT_NAME = "gpt-4o"
# AZURE_OPENAI_API_VERSION = "2024-02-15-preview"

# 3. 보안 로그인 계정 및 비밀번호 설정 (Gatekeeper SSO)
# 형식: 사용자ID = "비밀번호"
[passwords]
admin = "cj_tax_admin_2026!"
user = "cj_freshway_2026!"

# 4. 부가 시스템 설정 (기본값 유지 권장)
AUTH_ENABLED = "true"
TAX_BASE_DATE = "2026-01-01"
REVIEW_STORAGE_BACKEND = "sqlite"
