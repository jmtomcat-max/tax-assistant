    # 검색 실행 및 결과 렌더링
    if current_query:
        current_tax_type = st.session_state.get("selected_tax_type", "전체")
        
        # 1단계: Gemini AI 자연어 상황 분석 및 키워드 추출 (세션 캐싱)
        intent_key = f"intent_v3_{hash(current_query)}"
        if intent_key in st.session_state:
            intent_data = st.session_state[intent_key]
        else:
            with st.spinner("🧠 1단계: Gemini AI가 입력하신 상황의 법률 쟁점과 최적 검색 키워드를 분석 중입니다..."):
                intent_data = analyze_tax_situation(current_query)
                st.session_state[intent_key] = intent_data

        detected_tax = intent_data.get("tax_category", "조세일반")
        raw_keywords = intent_data.get("search_keywords", [current_query])
        core_issue = intent_data.get("core_issue", "")
        
        # 세목이 '전체'일 경우 AI가 판단한 세목 우선 반영
        effective_tax = current_tax_type if current_tax_type != "전체" else detected_tax

        # 🏷️ 하이브리드 키워드 풀 및 활성 선택 상태 관리
        kw_pool_key = f"kw_pool_{hash(current_query)}"
        kw_ver_key = f"kw_ver_{hash(current_query)}"
        kw_ver = st.session_state.get(kw_ver_key, 0)
        kw_pills_key = f"kw_pills_{hash(current_query)}_{kw_ver}"
        kw_active_key = f"kw_active_{hash(current_query)}"

        if kw_pool_key not in st.session_state:
            # 초기 키워드 풀: AI 추천 키워드 + 원문 속 고유 대상 명사 (상품권 등)
            init_pool = []
            for k in raw_keywords:
                for part in str(k).strip().split():
                    cl = re.sub(r'(은|는|이|가|을|를|에|의|과|와|으로|로)$', '', part)
                    if len(cl) >= 2 and cl not in init_pool and cl not in ["가능한가", "어떤가", "어떻게", "있는가", "지급한"]:
                        init_pool.append(cl)
            for token in re.findall(r'[가-힣]{2,}', current_query):
                cl = re.sub(r'(은|는|이|가|을|를|에|의|과|와|으로|로)$', '', token)
                if len(cl) >= 2 and cl not in init_pool and cl not in ["가능한가", "어떤가", "어떻게", "있는가", "지급한", "거래처", "인정이"]:
                    init_pool.append(cl)
            
            st.session_state[kw_pool_key] = init_pool[:7]
            st.session_state[kw_active_key] = list(init_pool[:7])

        available_keywords = st.session_state.get(kw_pool_key, [])
        
        # 활성 선택 키워드 결정: pills 위젯 상호작용이 있었으면 위젯 값 동기화, 신규 렌더링이면 kw_active_key 사용
        if kw_pills_key in st.session_state:
            active_keywords = st.session_state[kw_pills_key]
            st.session_state[kw_active_key] = active_keywords
        else:
            active_keywords = st.session_state.get(kw_active_key, available_keywords)

        if not active_keywords:
            active_keywords = available_keywords
        keywords = active_keywords

        # 2단계: 국가법령정보센터 실시간 다중 쿼리 검색 (활성 선택된 키워드 집합 반영)
        kw_hash_str = "_".join(sorted(active_keywords))
        search_cache_key = f"search_v4_{hash(current_query)}_{category_choice}_{current_tax_type}_{kw_hash_str}"
        if search_cache_key in st.session_state:
            search_res = st.session_state[search_cache_key]
        else:
            kw_str = ", ".join(active_keywords)
            with st.spinner(f"🏛️ 2단계: 선택된 키워드({kw_str})로 국가법령정보센터 DB에서 판례를 실시간 탐색 중입니다..."):
                search_res = search_real_law_data_multi(
                    keywords=active_keywords,
                    category=category_choice,
                    tax_type=current_tax_type,
                    oc_key=config.get_law_oc(),
                    limit=result_limit,
                    raw_query=current_query
                )
                st.session_state[search_cache_key] = search_res

        results = search_res.get("items", [])
        total_cnt = search_res.get("total", 0)
        error_msg = search_res.get("error")
        law_err_type = search_res.get("error_type", "LAW_API_ERROR")

        # [오류 구분 1]: 국가법령정보센터 DRF API 오류 렌더링
        if error_msg:
            st.markdown(f'''
            <div style="background:#FEF2F2; border:1.5px solid #FCA5A5; border-left:5px solid #DC2626; border-radius:10px; padding:16px 20px; margin:16px 0;">
                <div style="font-weight:700; color:#991B1B; font-size:1.0rem; display:flex; align-items:center; gap:8px;">
                    <span>🏛️</span> <span>[국가법령정보센터 DRF API 연동 오류]</span>
                </div>
                <div style="color:#B91C1C; font-size:0.90rem; margin-top:6px; line-height:1.6;">{error_msg}</div>
                <div style="font-size:0.80rem; color:#7F1D1D; margin-top:8px;">💡 조치 안내: .env 파일의 <code>LAW_API_KEY</code>를 확인하시거나 공공 API 네트워크 상태를 점검해 주세요.</div>
            </div>
            ''', unsafe_allow_html=True)

        # 3단계: 사용자 상황 맞춤 AI 종합 진단 브리핑 생성 (세션 캐싱)
        briefing_key = f"briefing_{hash(current_query)}_{len(results)}"
        if briefing_key in st.session_state:
            briefing_res = st.session_state[briefing_key]
        else:
            with st.spinner("💡 3단계: 검색된 판례를 근거로 사용자 상황 맞춤형 세무 종합 솔루션을 생성 중입니다..."):
                briefing_res = generate_situation_briefing(current_query, intent_data, results)
                st.session_state[briefing_key] = briefing_res

        # [오류 구분 2]: Google Gemini AI 모델 오류 렌더링
        ai_error_msg = briefing_res.get("error")
        if ai_error_msg:
            st.markdown(f'''
            <div style="background:#FAF5FF; border:1.5px solid #D8B4FE; border-left:5px solid #9333EA; border-radius:10px; padding:16px 20px; margin:16px 0;">
                <div style="font-weight:700; color:#6B21A8; font-size:1.0rem; display:flex; align-items:center; gap:8px;">
                    <span>🤖</span> <span>[Google Gemini AI 모델 처리 오류]</span>
                </div>
                <div style="color:#7E22CE; font-size:0.90rem; margin-top:6px; line-height:1.6;">{ai_error_msg}</div>
                <div style="font-size:0.80rem; color:#581C87; margin-top:8px;">💡 조치 안내: .env 파일의 <code>GEMINI_API_KEY</code> 설정 또는 API 할당량(Quota) 상태를 점검해 주세요.</div>
            </div>
            ''', unsafe_allow_html=True)

        # ================= [최상단] Gemini AI 상황 맞춤 종합 진단 브리핑 카드 =================
        briefing_clip_text = build_briefing_clipboard_text(current_query, intent_data, briefing_res)
        
        kw_badges_html = "".join([f'<span class="keyword-pill">#{kw}</span>' for kw in keywords])

        # 신호등 리스크 배지 생성 (들여쓰기 마크다운 코드블록 버그 방지)
        r_level = briefing_res.get("risk_level", "중립/유의")
        r_reason = briefing_res.get("risk_reason", "").strip()
        if not r_reason or r_reason == "---":
            r_reason = "사실관계 및 객관적 입증 증빙(계약서, 금융내역 등) 구비 여부에 따라 과세 여부가 갈립니다."

        if "고위험" in r_level:
            risk_tag_html = '<span class="risk-tag risk-tag-high">🔴 과세 리스크: 高 (주의 요망)</span>'
            risk_box_cls = 'risk-badge-box risk-high'
        elif "저위험" in r_level or "안전" in r_level:
            risk_tag_html = '<span class="risk-tag risk-tag-low">🟢 과세 리스크: 低 (비용인정 유력)</span>'
            risk_box_cls = 'risk-badge-box risk-low'
        else:
            risk_tag_html = '<span class="risk-tag risk-tag-medium">🟡 과세 리스크: 中 (증빙보강 필수)</span>'
            risk_box_cls = 'risk-badge-box risk-medium'

        risk_box_html = (
            f'<div class="{risk_box_cls}">'
            f'{risk_tag_html}'
            f'<span style="font-size:0.88rem; font-weight:600; line-height:1.5;">{r_reason}</span>'
            f'</div>'
        )

        situation_summary_str = intent_data.get('situation_summary', core_issue)

        # 4단계 근거 강도 배지 생성
        basis_strength = briefing_res.get("basis_strength", "유의 필요")
        basis_rationale = briefing_res.get("basis_rationale", "판례 및 법령 종합 검토 결과")
        
        if "확정 가능" in basis_strength:
            strength_badge_html = '<span style="background:#DCFCE7; color:#166534; border:1px solid #86EFAC; padding:4px 10px; border-radius:6px; font-weight:700; font-size:0.86rem;">🟢 근거 강도: 확정 가능</span>'
        elif "고위험" in basis_strength:
            strength_badge_html = '<span style="background:#FEE2E2; color:#991B1B; border:1px solid #FCA5A5; padding:4px 10px; border-radius:6px; font-weight:700; font-size:0.86rem;">🔴 근거 강도: 고위험</span>'
        elif "추가확인" in basis_strength:
            strength_badge_html = '<span style="background:#F1F5F9; color:#475569; border:1px solid #CBD5E1; padding:4px 10px; border-radius:6px; font-weight:700; font-size:0.86rem;">⚪ 근거 강도: 추가확인 필요</span>'
        else:
            strength_badge_html = '<span style="background:#FEF3C7; color:#92400E; border:1px solid #FCD34D; padding:4px 10px; border-radius:6px; font-weight:700; font-size:0.86rem;">🟡 근거 강도: 유의 필요</span>'

        strength_box_html = (
            f'<div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; background:#F8FAFC; border:1px solid #E2E8F0; padding:8px 14px; border-radius:8px; margin: 8px 0 12px 0;">'
            f'{strength_badge_html}'
            f'<span style="font-size:0.86rem; color:#334155; font-weight:600;">{basis_rationale}</span>'
            f'</div>'
        )

        # 사실관계 7대 요소 배지 렌더링 (들여쓰기 제거하여 마크다운 코드블록 오인 방지)
        s_facts = intent_data.get("structured_facts", {})
        facts_pills_html = (
            f'<div style="background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px; padding:10px 14px; margin-bottom:10px;">'
            f'<div style="font-size:0.80rem; font-weight:700; color:#64748B; margin-bottom:6px;">📋 추출된 사실관계 7대 핵심 요소</div>'
            f'<div style="display:flex; flex-wrap:wrap; gap:6px; font-size:0.80rem;">'
            f'<span style="background:#EFF6FF; color:#1D4ED8; padding:3px 8px; border-radius:4px;"><b>세목:</b> {s_facts.get("tax_category", detected_tax)}</span>'
            f'<span style="background:#F0FDF4; color:#15803D; padding:3px 8px; border-radius:4px;"><b>거래유형:</b> {s_facts.get("trans_type", "미상")}</span>'
            f'<span style="background:#FAF5FF; color:#7E22CE; padding:3px 8px; border-radius:4px;"><b>상대방:</b> {s_facts.get("counterparty", "미기재")}</span>'
            f'<span style="background:#FEF2F2; color:#B91C1C; padding:3px 8px; border-radius:4px;"><b>금액:</b> {s_facts.get("amount", "미기재")}</span>'
            f'<span style="background:#FFFBEB; color:#B45309; padding:3px 8px; border-radius:4px;"><b>과세기간:</b> {s_facts.get("tax_period", "해당 연도")}</span>'
            f'<span style="background:#F1F5F9; color:#334155; padding:3px 8px; border-radius:4px;"><b>보유증빙:</b> {s_facts.get("evidence_held", "확인 필요")}</span>'
            f'<span style="background:#F3F4F6; color:#1F2937; padding:3px 8px; border-radius:4px;"><b>검토목적:</b> {s_facts.get("purpose", "세무 적격성 검토")}</span>'
            f'</div>'
            f'</div>'
        )

        # 추가 확인 필요사항 경고 박스 (들여쓰기 제거하여 마크다운 코드블록 오인 방지)
        missing_facts = intent_data.get("missing_facts", [])
        missing_box_html = ""
        if missing_facts:
            missing_items_li = "".join([f"<li style='margin-bottom:3px;'>{item}</li>" for item in missing_facts])
            missing_box_html = (
                f'<div style="background:#FFFBEB; border:1.5px solid #FCD34D; border-left:5px solid #D97706; border-radius:8px; padding:12px 16px; margin: 10px 0 14px 0;">'
                f'<div style="display:flex; align-items:center; gap:8px; font-weight:700; color:#B45309; font-size:0.92rem;">'
                f'<span>⚠️</span> <span>[핵심 사실관계 추가 확인 필요사항] 결론 확정 전 필수 점검</span>'
                f'</div>'
                f'<div style="font-size:0.84rem; color:#92400E; margin-top:6px;">'
                f'아래 사실관계가 확정되지 않은 상태이므로 최종 판단을 단정할 수 없으며, 과세관청의 처분 방향이 달라질 수 있습니다:'
                f'</div>'
                f'<ul style="margin: 6px 0 0 18px; padding:0; font-size:0.83rem; color:#78350F;">'
                f'{missing_items_li}'
                f'</ul>'
                f'</div>'
            )

        briefing_card_html = (
            f'<div class="ai-briefing-card">'
            f'<div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:8px;">'
            f'<div>'
            f'<span class="ai-briefing-tag">✨ GEMINI AI 맞춤 세무 진단 솔루션</span>'
            f'<div style="font-size:1.18rem; font-weight:800; color:#0F172A; margin: 4px 0 6px 0;">'
            f'상황 분석: {situation_summary_str}'
            f'</div>'
            f'<div style="font-size:0.86rem; color:#475569; margin-bottom:8px;">'
            f'세목 분류: <b style="color:#005B45;">[{detected_tax}]</b> | 핵심 쟁점: <b>{core_issue}</b>'
            f'</div>'
            f'<div style="margin-bottom:8px;">'
            f'<span style="font-size:0.82rem; color:#64748B; margin-right:6px;">발굴 검색어:</span>'
            f'{kw_badges_html}'
            f'</div>'
            f'</div>'
            f'</div>'
            f'{strength_box_html}'
            f'{facts_pills_html}'
            f'{missing_box_html}'
            f'{risk_box_html}'
            f'</div>'
        )
        st.markdown(briefing_card_html, unsafe_allow_html=True)

        # 브리핑 상단 컨트롤 바 (복사 버튼 & 보관함 담기)
        briefing_case_id = f"briefing_{abs(hash(current_query))}"
        is_briefing_saved = briefing_case_id in st.session_state["saved_cases"]
        
        col_br_title, col_br_save, col_br_copy = st.columns([3.5, 1.4, 2.1], vertical_alignment="center")
        with col_br_title:
            st.markdown("<div style='font-size:0.95rem; font-weight:700; color:#005B45;'>📊 AI 세무전문가 종합 실무 의견서</div>", unsafe_allow_html=True)
        with col_br_save:
            btn_save_br_label = "★ 사례 보관 해제" if is_briefing_saved else "☆ 사례 보관함 저장"
            if st.button(btn_save_br_label, key=f"btn_save_{briefing_case_id}", use_container_width=True):
                if is_briefing_saved:
                    del st.session_state["saved_cases"][briefing_case_id]
                    save_saved_cases(st.session_state["saved_cases"])
                    st.toast("세무검토 사례가 보관함에서 삭제되었습니다.", icon="🗑️")
                    st.rerun()
                else:
                    # 중복 검사 실행
                    is_dup, dup_msg, dup_id = check_duplicate_case(st.session_state["saved_cases"], None, current_query, briefing_case_id)
                    if is_dup:
                        st.warning(f"⚠️ {dup_msg}")
                    
                    # 실제 검색/인용된 판례 목록만 legal_references로 엄격 주입
                    real_refs = []
                    for c in briefing_res.get("cited_cases", []):
                        if c.get("case_number"):
                            real_refs.append({
                                "type": "판례/예규",
                                "title": c.get("title", ""),
                                "case_number": c.get("case_number", ""),
                                "court": c.get("court", ""),
                                "date": c.get("date", ""),
                                "link": c.get("link", ""),
                                "source": c.get("source", "국가법령정보센터"),
                                "prec_id": c.get("prec_id", "")
                            })
                    
                    saved_br_item = {
                        "case_id": briefing_case_id,
                        "title": f"[{detected_tax}] {intent_data.get('situation_summary', current_query[:40])}",
                        "tax_category": detected_tax,
                        "issue_tags": [detected_tax] + [kw for kw in keywords[:4]],
                        "risk_level": briefing_res.get("risk_level", "중립/유의"),
                        "review_status": "검토중",
                        "user_query": current_query,
                        "facts_summary": intent_data.get("structured_facts", {}),
                        "legal_references": real_refs,
                        "ai_opinion": {
                            "basis_strength": briefing_res.get("basis_strength", "유의 필요"),
                            "basis_rationale": briefing_res.get("basis_rationale", "판례 및 법령 종합 검토"),
                            "conclusion": briefing_res.get("conclusion", ""),
                            "case_comparison": briefing_res.get("case_comparison", ""),
                            "checklist": briefing_res.get("checklist", "")
                        },
                        "user_memo": "",
                        "created_at": pd.Timestamp.now().strftime('%Y-%m-%d %H:%M'),
                        "updated_at": pd.Timestamp.now().strftime('%Y-%m-%d %H:%M'),
                        # 하위 호환
                        "case_number": f"TAX-{pd.Timestamp.now().strftime('%m%d%H%M')}",
                        "date": pd.Timestamp.now().strftime('%Y-%m-%d'),
                        "court": "Gemini AI 세무검토",
                        "source": "CJ프레시웨이 TAX AI",
                        "prec_id": briefing_case_id,
                        "link": "",
                        "saved_at": pd.Timestamp.now().strftime('%Y-%m-%d %H:%M'),
                        "ai_summary": {
                            "legal_basis": briefing_res.get('conclusion', ''),
                            "tax_office_view": "과세관청 입증 책임 및 법령 요건 엄격 적용",
                            "taxpayer_view": "거래의 실질 및 합리적 경제 행위 소명",
                            "court_decision": briefing_res.get('case_comparison', ''),
                            "actionable_takeaway": briefing_res.get('checklist', '')
                        }
                    }
                    st.session_state["saved_cases"][briefing_case_id] = saved_br_item
                    save_saved_cases(st.session_state["saved_cases"])
                    st.toast("📁 세무검토 사례 카드가 보관함에 안전하게 저장되었습니다!", icon="⭐")
                    st.rerun()
        with col_br_copy:
            render_copy_button(briefing_clip_text, f"cp_{briefing_case_id}")

        # 3대 섹션 노션 스타일 렌더링
        st.markdown(f"""
        <div class="notion-block nb-green">
            <div class="notion-icon">⚖️</div>
            <div class="notion-body">
                <div class="notion-title">1. 세무 리스크 진단 및 핵심 결론</div>
                {format_notion_content(briefing_res.get('conclusion', ''))}
            </div>
        </div>
        """, unsafe_allow_html=True)

        col_b_left, col_b_right = st.columns(2)
        with col_b_left:
            st.markdown(f"""
            <div class="notion-block nb-cjblue">
                <div class="notion-icon">🏛️</div>
                <div class="notion-body">
                    <div class="notion-title">2. 관련 실제 판례와의 비교 및 법원 판단 취지</div>
                    {format_notion_content(briefing_res.get('case_comparison', ''))}
                </div>
            </div>
            """, unsafe_allow_html=True)
        with col_b_right:
            st.markdown(f"""
            <div class="notion-block nb-orange">
                <div class="notion-icon">💼</div>
                <div class="notion-body">
                    <div class="notion-title">3. 실무자 필수 증빙 체크리스트 & 행동 수칙</div>
                    {format_notion_content(briefing_res.get('checklist', ''))}
                </div>
            </div>
            """, unsafe_allow_html=True)

        # 📄 3가지 보고서 포맷 탭 (요약형 / 검토의견형 / 상세검토형) + 복사 및 TXT 다운로드
        st.markdown("<div style='height: 12px;'></div>", unsafe_allow_html=True)
        st.markdown("<div style='font-size:0.95rem; font-weight:700; color:#0F172A; margin-bottom:8px;'>📑 목적별 3대 세무 보고서 (클릭 시 복사 및 .txt 즉시 다운로드)</div>", unsafe_allow_html=True)
        
        rep_summary_txt = format_report_summary(intent_data, briefing_res)
        rep_opinion_txt = format_report_opinion(intent_data, briefing_res)
        rep_detailed_txt = format_report_detailed(intent_data, briefing_res)

        tab_rep_sum, tab_rep_op, tab_rep_det = st.tabs(["📊 1. 요약형 (경영진 1분 보고)", "📝 2. 검토의견형 (팀내 실무 회신)", "📑 3. 상세검토형 (세무조사 방어/감사용)"])

        with tab_rep_sum:
            col_rs_c, col_rs_d = st.columns([1.5, 1.5], vertical_alignment="center")
            with col_rs_c:
                render_copy_button(rep_summary_txt, f"cp_rep_sum_{hash(current_query)}")
            with col_rs_d:
                st.download_button(
                    label="💾 요약형 .txt 다운로드",
                    data=rep_summary_txt.encode("utf-8"),
                    file_name=f"CJ프레시웨이_세무요약보고서_{pd.Timestamp.now().strftime('%Y%m%d_%H%M')}.txt",
                    mime="text/plain",
                    use_container_width=True,
                    key=f"dl_rep_sum_{hash(current_query)}"
                )
            st.code(rep_summary_txt, language="markdown")

        with tab_rep_op:
            col_ro_c, col_ro_d = st.columns([1.5, 1.5], vertical_alignment="center")
            with col_ro_c:
                render_copy_button(rep_opinion_txt, f"cp_rep_op_{hash(current_query)}")
            with col_ro_d:
                st.download_button(
                    label="💾 검토의견형 .txt 다운로드",
                    data=rep_opinion_txt.encode("utf-8"),
                    file_name=f"CJ프레시웨이_세무검토의견서_{pd.Timestamp.now().strftime('%Y%m%d_%H%M')}.txt",
                    mime="text/plain",
                    use_container_width=True,
                    key=f"dl_rep_op_{hash(current_query)}"
                )
            st.code(rep_opinion_txt, language="markdown")

        with tab_rep_det:
            col_rd_c, col_rd_d = st.columns([1.5, 1.5], vertical_alignment="center")
            with col_rd_c:
                render_copy_button(rep_detailed_txt, f"cp_rep_det_{hash(current_query)}")
            with col_rd_d:
                st.download_button(
                    label="💾 상세검토형 .txt 다운로드",
                    data=rep_detailed_txt.encode("utf-8"),
                    file_name=f"CJ프레시웨이_세무심층검토보고서_{pd.Timestamp.now().strftime('%Y%m%d_%H%M')}.txt",
                    mime="text/plain",
                    use_container_width=True,
                    key=f"dl_rep_det_{hash(current_query)}"
                )
            st.code(rep_detailed_txt, language="markdown")

        st.markdown("<hr style='border:none; border-top:1px solid #CBD5E1; margin: 24px 0 16px 0;'>", unsafe_allow_html=True)

        # 상단 요약 바 & 다운로드 / 홈으로 가기 버튼
        col_count, col_home, col_excel = st.columns([3.5, 1.0, 1.5], vertical_alignment="center")
        with col_count:
            tax_filter_str = f" · 세목: <b style='color:#005B45;'>{current_tax_type}</b>" if current_tax_type != "전체" else f" · 세목: <b style='color:#005B45;'>{detected_tax}</b>"
            st.markdown(f"<div style='font-size:0.92rem; color:#1E293B; font-weight:600;'>🏛️ 발굴 판례 및 예규 총 <b>{total_cnt:,}건</b> (솔루션 인용 <b>{len(briefing_res.get('cited_cases', []))}건</b>{tax_filter_str})</div>", unsafe_allow_html=True)
        with col_home:
            if st.button("🔄 새 상황 질문", key="btn_reset_home", use_container_width=True, help="초기 홈 화면으로 돌아가기"):
                st.session_state["search_input"] = ""
                st.session_state["selected_tax_type"] = "전체"
                st.session_state["input_version"] = st.session_state.get("input_version", 0) + 1
                st.rerun()
        with col_excel:
            # 엑셀 다운로드: 인용 판례와 검색 결과를 통합하여 다운로드 지원
            export_list = list(briefing_res.get("cited_cases", [])) + list(results)
            if export_list:
                df_export = pd.DataFrame(export_list)[["tax_category", "court", "case_number", "date", "title", "source", "link"]]
                df_export.columns = ["세목", "기관/법원", "사건번호", "선고일자", "사건명(판결요지)", "출처", "원문링크"]
                df_export = df_export.drop_duplicates(subset=["사건번호"])
                
                buffer = io.BytesIO()
                with pd.ExcelWriter(buffer, engine='openpyxl') as writer:
                    df_export.to_excel(writer, index=False, sheet_name='판례검색결과')
                
                st.download_button(
                    label="📥 판례 엑셀 다운",
                    data=buffer.getvalue(),
                    file_name=f"세무판례_{current_tax_type}_{pd.Timestamp.now().strftime('%Y%m%d_%H%M')}.xlsx",
                    mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                    use_container_width=True
                )

        st.markdown("<div style='height: 10px;'></div>", unsafe_allow_html=True)

        # =========================================================================
        # 📌 듀얼 탭 (Dual Tabs) 아키텍처: [솔루션 인용 핵심 판례] vs [국가법령 DB 추가 검색]
        # =========================================================================
        cited_cases = briefing_res.get("cited_cases", [])
        tab_cited_title = f"📌 솔루션 인용 핵심 판례·예규 ({len(cited_cases)}건)"
        tab_search_title = f"🔍 국가법령 DB 추가 직접 검색 ({total_cnt:,}건)"

        tab_cited, tab_search = st.tabs([tab_cited_title, tab_search_title])

        # ----------------- Tab 1: 솔루션 인용 핵심 판례·예규 -----------------
        with tab_cited:
            unverified_cnt = briefing_res.get("unverified_count", 0)
            unverified_banner = ""
            if unverified_cnt > 0:
                unverified_banner = f"""
                <div style="background:#FFFBEB; border:1.5px solid #FDE68A; border-left:4px solid #D97706; border-radius:8px; padding:11px 15px; margin-bottom:12px; font-size:0.83rem; color:#92400E; line-height:1.55;">
                    <b>🛡️ 판례 인용 신뢰성 검증기 작동</b>: AI가 제안한 판례 중 <b>{unverified_cnt}건</b>은 이번 국가법령정보센터 실시간 검색 결과 풀에서 확인되지 않아 <b>'검색된 공식 DB 결과 내에서 확인되지 않음'</b>으로 판정하고 사건번호 표시를 안전하게 배제하였습니다. (아래 목록은 100% 실존하는 검증 판례입니다)
                </div>
                """

            st.markdown(f"""
            {unverified_banner}
            <div style="background:#F0FDF4; border:1px solid #DCFCE7; border-left:4px solid #005B45; border-radius:6px; padding:10px 14px; margin-bottom:14px;">
                <div style="font-size:0.88rem; font-weight:700; color:#005B45;">
                    💡 Gemini AI 세무 진단 솔루션의 실제 판단 근거가 된 핵심 판례 및 예규 목록입니다.
                </div>
                <div style="font-size:0.80rem; color:#475569; margin-top:2px;">
                    위 의견서에서 제시한 세무 리스크와 행동 수칙은 국가법령정보센터 실제 DB와 100% 일치함이 검증된 판례·예규만을 근거로 합니다.
                </div>
            </div>
            """, unsafe_allow_html=True)

            if not cited_cases:
                st.markdown(f"""
                <div class="notion-block nb-gray" style="margin-top:10px;">
                    <div class="notion-icon">📋</div>
                    <div class="notion-body">
                        <div class="notion-title">인용된 별도 사건 목록이 없습니다</div>
                        위 종합 의견서 전문을 참고하시거나, '🔍 국가법령 DB 추가 직접 검색' 탭에서 법령정보센터의 원문 판례를 확인해 보세요.
                    </div>
                </div>
                """, unsafe_allow_html=True)
            else:
                for c_idx, c_item in enumerate(cited_cases):
                    render_case_card(c_item, c_idx, prefix="cited")

        # ----------------- Tab 2: 국가법령 DB 추가 직접 검색 -----------------
        with tab_search:
            # 🏷️ [하이브리드 키워드 인터랙션] 키워드 태그 정밀 타격 바
            active_kw_display = ", ".join(active_keywords) if active_keywords else "선택 없음"
            st.markdown(f"""
            <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px; padding:10px 14px; margin-bottom:12px;">
                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
                    <div style="font-size:0.86rem; font-weight:700; color:#1E293B;">
                        🏷️ 국가법령정보센터 DRF 실시간 연동 키워드 <span style="font-size:0.78rem; font-weight:normal; color:#64748B;">(태그를 클릭하여 켜고 끄거나 법률 단어를 추가하세요)</span>
                    </div>
                    <div style="font-size:0.80rem; color:#005B45; font-weight:600; background:#E6F4EA; padding:2px 8px; border-radius:4px;">
                        선택 키워드: {active_kw_display}
                    </div>
                </div>
            </div>
            """, unsafe_allow_html=True)

            col_pills, col_add = st.columns([3.3, 2.1], vertical_alignment="center")
            with col_pills:
                chosen_pills = st.pills(
                    "판례 키워드 태그",
                    options=available_keywords,
                    default=active_keywords,
                    selection_mode="multi",
                    key=kw_pills_key,
                    label_visibility="collapsed"
                )
            with col_add:
                with st.form(key=f"add_kw_form_{hash(current_query)}_{kw_ver}", clear_on_submit=True):
                    c_in, c_btn = st.columns([1.8, 1.2], vertical_alignment="center")
                    with c_in:
                        new_kw_val = st.text_input("새 키워드 입력", placeholder="+ 새 키워드 입력", label_visibility="collapsed")
                    with c_btn:
                        btn_add_kw = st.form_submit_button("추가", use_container_width=True)
                    if btn_add_kw and new_kw_val.strip():
                        clean_new = new_kw_val.strip()
                        if clean_new not in available_keywords:
                            available_keywords.append(clean_new)
                            st.session_state[kw_pool_key] = available_keywords
                        cur_active = list(st.session_state.get(kw_active_key, available_keywords))
                        if clean_new not in cur_active:
                            cur_active.append(clean_new)
                        st.session_state[kw_active_key] = cur_active
                        st.session_state[kw_ver_key] = kw_ver + 1
                        st.rerun()

            st.markdown("<div style='height: 12px;'></div>", unsafe_allow_html=True)

            # 국가법령정보센터 DRF 검색 결과 리스트 렌더링
            if not results:
                st.markdown(f"""
                <div class="notion-block nb-gray" style="margin-top:20px;">
                    <div class="notion-icon">🔍</div>
                    <div class="notion-body">
                        <div class="notion-title">입력하신 상황에 부합하는 {current_tax_type} 판례를 직접 매칭하지 못했습니다</div>
                        상황 설명을 조금 더 구체적으로 작성해 주시거나 세목 필터를 '전체'로 변경해 보세요.
                    </div>
                </div>
                """, unsafe_allow_html=True)
            else:
                for idx, item in enumerate(results):
                    render_case_card(item, idx, prefix="search")
