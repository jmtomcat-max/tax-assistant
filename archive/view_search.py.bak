                st.markdown("<div style='font-size:0.86rem; color:#64748B; margin-bottom:8px;'>경영진 보고용, 실무 회신용, 감사 방어용 보고서를 원클릭으로 복사/다운로드 할 수 있습니다.</div>", unsafe_allow_html=True)
                
