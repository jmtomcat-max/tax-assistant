                        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:6px;">
                            <div style="font-size:0.83rem; font-weight:700; color:#1E293B;">
                                🏷️ 국가법령정보센터 DRF 실시간 연동 키워드
                            </div>
                            <div style="font-size:0.78rem; color:#005B45; font-weight:600; background:#E6F4EA; padding:2px 6px; border-radius:4px;">
                                선택 키워드: {active_kw_display}
                            </div>
                        </div>
                    </div>
                    """, unsafe_allow_html=True)

                    st.markdown("<div style='font-size:0.79rem; color:#64748B; margin-bottom:4px; font-weight:600;'>🏷️ 검색 태그 선택/해제 (클릭 시 실시간 필터링)</div>", unsafe_allow_html=True)
                    chosen_pills = st.pills(
                        "판례 키워드 태그",
                        options=available_keywords,
                        default=active_keywords,
                        selection_mode="multi",
                        key=kw_pills_key,
                        label_visibility="collapsed"
                    )

                    st.markdown("<div style='height: 8px;'></div>", unsafe_allow_html=True)
                    with st.form(key=f"add_kw_form_{hash(current_query)}_{kw_ver}", clear_on_submit=True):
                        c_in, c_btn = st.columns([4.2, 1.2], vertical_alignment="center")
                        with c_in:
                            new_kw_val = st.text_input("새 키워드 입력", placeholder="+ 추가할 검색 키워드 직접 입력 (예: 부당행위계산)", label_visibility="collapsed")
                        with c_btn:
                            btn_add_kw = st.form_submit_button("➕ 키워드 추가", use_container_width=True)
                        if btn_add_kw and new_kw_val.strip():
                            clean_new = new_kw_val.strip()
                            if clean_new not in available_keywords and clean_new not in STOP_KEYWORDS:
                                available_keywords.append(clean_new)
                                st.session_state[kw_pool_key] = available_keywords
                            cur_active = list(st.session_state.get(kw_active_key, available_keywords))
                            if clean_new not in cur_active and clean_new not in STOP_KEYWORDS:
                                cur_active.append(clean_new)
                            st.session_state[kw_active_key] = cur_active
                            st.session_state[kw_ver_key] = kw_ver + 1
                            st.rerun()

                    st.markdown("<div style='height: 10px;'></div>", unsafe_allow_html=True)

                    if not results:
                        st.markdown(f"""
                        <div class="notion-block nb-gray" style="margin-top:16px;">
                            <div class="notion-icon">🔍</div>
                            <div class="notion-body">
                                <div class="notion-title">입력하신 상황에 부합하는 {current_tax_type} 판례를 직접 매칭하지 못했습니다</div>
                                상황 설명을 조금 더 구체적으로 작성해 주시거나 세목 필터를 '전체'로 변경해 보세요.
                            </div>
                        </div>
                        """, unsafe_allow_html=True)
                    else:
                        high_rel_cases = [it for it in results if it.get("is_high_relevance", False) or it.get("relevance_score", 0) >= 50]
                        low_rel_cases = [it for it in results if it not in high_rel_cases]

                        if not high_rel_cases and results:
                            high_rel_cases = results[:3]
                            low_rel_cases = results[3:]

                        st.markdown(f"""
                        <div style="display:flex; justify-content:space-between; align-items:center; background:#F8FAFC; border:1px solid #E2E8F0; border-radius:6px; padding:6px 10px; margin-bottom:10px; font-size:0.78rem;">
                            <div style="color:#334155;">
                                🎯 <b>정밀 연관 판례 필터링:</b> 질문 핵심 거래 매칭 판례 <b>{len(high_rel_cases)}건</b>
                            </div>
                            <div style="color:#64748B;">
                                단순 일치 판례 {len(low_rel_cases)}건 접어둠
                            </div>
                        </div>
                        """, unsafe_allow_html=True)

                        for idx, item in enumerate(high_rel_cases):
                            render_case_card(item, idx, prefix="search_high")

                        if low_rel_cases:
                            st.markdown("<div style='height: 6px;'></div>", unsafe_allow_html=True)
                            with st.expander(f"📁 관련도 낮은 추가 검색 결과 ({len(low_rel_cases)}건 접어둠)", expanded=False):
                                for l_idx, l_item in enumerate(low_rel_cases):
                                    render_case_card(l_item, l_idx, prefix="search_low")
